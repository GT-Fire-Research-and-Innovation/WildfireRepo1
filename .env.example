# Copy to .env (git-ignored) and fill in. HF_TOKEN and the Earth Engine key are read from the environment only.
FIRMS_MAP_KEY=your_firms_map_key   # free: https://firms.modaps.eosdis.nasa.gov/api/map_key/ (channel firms)
EARTHDATA_TOKEN=your_token         # free: https://urs.earthdata.nasa.gov > Generate Token (viirs, vegetation, landcover)
